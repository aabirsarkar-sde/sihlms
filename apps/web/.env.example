DATABASE_URL=postgresql://sahakar:sahakar@localhost:5432/sahakar
# Non-pooled URL used only for migrations (Neon/Supabase). Leave unset locally.
# DIRECT_URL=
AUTH_SECRET=dev-secret-change-me-0123456789abcdef0123
APP_URL=http://localhost:3000
FACE_SVC_URL=http://localhost:8001
# Keeps OTP at 123456 and shows the one-tap demo logins in production builds
# DEMO_MODE=true
# Vercel Blob store (private). When set, files go to Blob instead of ./uploads
# BLOB_READ_WRITE_TOKEN=
# Protects /api/v1/cron (Vercel Cron sends it automatically)
# CRON_SECRET=
# Optional: LLM chatbot + lesson auto-translate. Without it the chatbot uses FAQ matching.
# ANTHROPIC_API_KEY=sk-ant-...
